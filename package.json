{
  "name": "cookbook-web",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build:data": "node build.mjs",
    "build:js": "esbuild client.js --bundle --format=iife --outfile=site/recipe-app.js",
    "build": "npm run build:data && npm run build:js && Rscript -e \"babelquarto::render_website(project_path = 'site')\" && node self-check.mjs --site",
    "check": "node check-sources.mjs",
    "test": "node self-check.mjs",
    "serve": "python3 -m http.server 8801 -d site/_site"
  },
  "type": "commonjs",
  "devDependencies": {
    "@gram-lang/analyzer": "^1.2.0",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
